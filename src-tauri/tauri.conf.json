{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Draw me a kicker",
  "version": "2.0.0",
  "identifier": "com.drawmeakicker.desktop",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm desktop:dev",
    "beforeBuildCommand": "pnpm desktop:build"
  },
  "app": {
    "windows": [
      {
        "title": "Draw me a kicker!",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' data: blob: ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
